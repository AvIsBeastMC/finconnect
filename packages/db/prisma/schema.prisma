// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  password        String
  currencyWallets CurrencyWallet[]
}

model CurrencyWallet {
  id           String        @id @default(cuid())
  pin          Int
  account      Account       @relation(references: [id], fields: [accountId])
  currency     String        @default("USD")
  balance      Float         @default(0)
  transactions Transaction[]
  deposits     Deposits[]

  accountId String
}

model Transaction {
  id             String         @id @default(cuid())
  currencyWallet CurrencyWallet @relation(references: [id], fields: [currencyWalletId])
  target         String
  amount         Float
  time           DateTime       @default(now())

  currencyWalletId String
}

model Deposits {
  id             String         @id @default(cuid())
  amount         Float
  source         String
  currencyWallet CurrencyWallet @relation(references: [id], fields: [currencyWalletId])
  time           DateTime       @default(now())

  currencyWalletId String
}
